# Outputs of a demo run (regenerated by demo/run_demo.R); the shipped demo inputs stay tracked
# the folder skeleton (README.md and .gitkeep files) stays tracked so the layout is visible in a clone
demo/data/housing_targets/output/**
demo/data/housing_targets/produced/**
demo/data/housing_targets/temp/**
demo/data/housing_search/temp/**
!demo/data/housing_targets/output/**/
!demo/data/housing_targets/produced/**/
!demo/data/housing_targets/temp/**/
!demo/data/housing_search/temp/**/
!demo/data/**/README.md
!demo/data/**/.gitkeep
!demo/data/housing_targets/produced/gap/*
!demo/data/housing_targets/temp/oa_to_la.gpkg
# names of the real search data stay on the authors' machine
config_local.R
config_local.py
# editors and R
.Rproj.user/
.Rhistory
.RData
__pycache__/
# by-products of running the scripts with Rscript (print() to a non-interactive device) and of the OSM tile cache
Rplots.pdf
maps/rosm.cache/
# the demo data generators stay local (only the generated data is distributed)
demo/generator/
# scripts outside the paper pipeline stay local
extra/
